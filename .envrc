# Enter the devenv shell automatically on cd. Needs direnv (https://direnv.net);
# `devenv direnvrc` supplies the `use devenv` implementation, so nothing has to
# be installed into ~/.config/direnv.
if ! has devenv; then
  log_error "devenv is not on PATH — see https://devenv.sh/getting-started/"
  exit 1
fi

eval "$(devenv direnvrc)"
use devenv
